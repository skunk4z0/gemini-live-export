{
  "manifest_version": 3,
  "name": "Gemini Live Export for Obsidian",
  "version": "0.0.0",
  "description": "Save the current Gemini chat as Obsidian-compatible Markdown.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Gemini Live Export",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://gemini.google.com/*"],
      "js": ["src/messages.js", "src/content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["downloads"],
  "host_permissions": ["https://gemini.google.com/*"]
}
